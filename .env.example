# ==============================================================================
# AUTONOMOUS DATA ANALYST AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=
OPENAI_TEMPERATURE=0.1

# Execution Sandbox Configuration
# Isolated secure out-of-process subprocess runner
EXECUTION_SANDBOX_TYPE=secure_subprocess
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_PERCENT=80
MAX_CORRECTION_RETRIES=3

# Storage & Database
STORAGE_PATH=./data
DATABASE_URL=sqlite:///./data/autonomous_analyst.db

# Logging
LOG_LEVEL=INFO
